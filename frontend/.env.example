# Firebase コンソールの「ウェブアプリを追加」で表示される値をコピーして .env を作る（.env はコミットされない）
# 注意: これらは秘密情報ではない。VITE_ 付きの値はビルド時に dist/ へ埋め込まれ、ブラウザから読める。
# データを守るのは Firestore のセキュリティルール（BACKEND.md 0-5-3）であって、この値を隠すことではない。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
